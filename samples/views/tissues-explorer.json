{
  "template": "tissues-explorer.html",
  "css": "tissues-explorer.css",
  "api": "https://www.appropedia.org/w/api.php",
  "globals": {
    "pages": {
      "semantic_search": "[[~TissueDB/Tissues/*]]",
      "printouts": [ "Page description", "Page keywords" ]
    },
    "properties": {
      "printout_value_set": "pages",
      "printouts": "Page keywords"
    }
  },
  "filters": {
    "global_merge_operation": "disjunction"
  }
}
